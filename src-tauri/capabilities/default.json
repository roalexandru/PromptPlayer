{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline capabilities every window inherits",
  "windows": ["library", "picker", "tray-popup", "about", "diagnostics"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:webview:default",
    "global-shortcut:default",
    "dialog:default",
    "autostart:default",
    "aptabase:allow-track-event",
    "os:default",
    "updater:default",
    "process:default"
  ]
}
