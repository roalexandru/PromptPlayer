+    const DENIED_FLAG_PREFIXES: &[&str] =
+        &["--exec", "--upload-pack", "--receive-pack", "--config-env"];
+    if let Some(bad) = args.iter().find(|a| {
+        *a == "-c" || a.starts_with("-c=") || DENIED_FLAG_PREFIXES.iter().any(|p| a.starts_with(p))
