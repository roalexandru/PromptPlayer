+            "Review this diff and tell me"
+        );
+    }
+
+    #[test]
+    fn naming_handles_short_and_empty_input() {
+        assert_eq!(first_words("hi", 6), "hi");
+        assert_eq!(first_words("   ", 6), "Captured prompt");
+    }
