+            let Some(elapsed) = ctx.state.armed_for() else {
+                continue;
+            };
+            if elapsed >= limit {
+                tracing::info!("auto-disarm: armed for {:?}, disarming", elapsed);
+                // Through the shared helper so this persists and reports like
+                // any other arm transition.
