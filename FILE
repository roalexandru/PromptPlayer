+  .block-head h4 {
+    margin: 0;
+    font-size: 13px;
+  }
+  .hint,
+  .field-hint {
+    font-size: 11px;
+    color: var(--text-secondary, #6b7280);
+  }
+  .row {
+    display: flex;
